{
  "info": {
    "name": "Sprint 2 - US1-A US1-B Login",
    "description": "Task30: ทดสอบ login นักศึกษา (US1-A) และเจ้าหน้าที่ (US1-B)\n\nวิธีใช้\n1. รัน `docker compose up -d --build` แล้วเรียกผ่าน Nginx ที่ http://localhost:18080\n2. กรอกตัวแปร `studentEmail` และ `studentId` ด้วยบัญชี TU ที่ใช้ได้จริง (ห้าม commit ค่าจริง)\n3. Run collection ตามลำดับ โฟลเดอร์ 2 ข้อ 2.3 ต้องรันหลังโฟลเดอร์ 1 เพราะนักศึกษาต้องเคย login มาก่อน\nPostman เก็บ session cookie ให้เอง",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "staffUsername",
      "value": "staff01"
    },
    {
      "key": "staffPassword",
      "value": "staff1234"
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "unknownStudentId",
      "value": "6000000000"
    },
    {
      "key": "missingId",
      "value": "999999"
    }
  ],
