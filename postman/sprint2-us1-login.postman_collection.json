              "path": [
                "api",
                "auth",
                "student",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"not.this.student@dome.tu.ac.th\",\n  \"password\": \"{{studentId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.eql('ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง'));"
