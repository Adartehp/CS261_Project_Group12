    {
      "name": "4 US8 staff history filters",
      "item": [
        {
          "name": "4.1 All requests, newest first",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/repair-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "repair-requests"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('is array', () => pm.expect(b).to.be.an('array'));",
                  "pm.test('newest first', () => { for (let i = 1; i < b.length; i++) pm.expect(b[i-1].createdAt >= b[i].createdAt).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Filter status=DONE",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/repair-requests?status=DONE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "repair-requests"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "DONE"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('only DONE', () => b.forEach(r => pm.expect(r.status).to.eql('DONE')));",
                  "pm.test('contains pendingId', () => pm.expect(b.map(r => String(r.id))).to.include(pm.collectionVariables.get('pendingId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Filter status=cancelled (lowercase)",
