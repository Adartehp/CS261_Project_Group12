{
  "info": {
    "name": "Sprint 2 - US7 US8 Staff status and history",
    "description": "Task41: ทดสอบการเปลี่ยนสถานะ (US7) และประวัติของเจ้าหน้าที่ (US8)\n\nวิธีใช้\n1. รัน `docker compose up -d --build` แล้วเรียกผ่าน Nginx ที่ http://localhost:18080\n2. กรอกตัวแปร `studentEmail` และ `studentId` ด้วยบัญชี TU ที่ใช้ได้จริง (ห้าม commit ค่าจริง)\n3. Run collection ตามลำดับ โฟลเดอร์ 1 สร้างคำร้อง 2 รายการแล้วเก็บ id ไว้ใน `pendingId` และ `cancelId`\nPostman เก็บ session cookie ให้เอง การ login คนใหม่จะแทน session เดิม\n\nลำดับที่อนุญาต: IN_PROGRESS -> DONE, PENDING -> CANCELLED, IN_PROGRESS -> CANCELLED ลำดับอื่นได้ 409",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "staffUsername",
      "value": "staff01"
    },
    {
      "key": "staffPassword",
      "value": "staff1234"
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "pendingId",
      "value": ""
    },
    {
      "key": "cancelId",
      "value": ""
    },
    {
      "key": "missingId",
      "value": "999999"
    }
  ],
  "item": [
    {
      "name": "1 Setup - student creates requests",
      "item": [
        {
          "name": "1.1 Student login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/student/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "student",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentEmail}}\",\n  \"password\": \"{{studentId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('role STUDENT', () => pm.expect(pm.response.json().role).to.eql('STUDENT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Create request for DONE flow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/repair-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "repair-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"A-101\",\n  \"area\": \"bedroom\",\n  \"repairItem\": \"หลอดไฟเสีย (Task41)\",\n  \"description\": \"ทดสอบเปลี่ยนสถานะเป็นซ่อมเสร็จ\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('pendingId', pm.response.json().id);",
                  "pm.test('PENDING', () => pm.expect(pm.response.json().status).to.eql('PENDING'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Create request for CANCEL flow",
