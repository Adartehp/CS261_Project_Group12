              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('only CANCELLED', () => b.forEach(r => pm.expect(r.status).to.eql('CANCELLED')));",
                  "pm.test('contains cancelId', () => pm.expect(b.map(r => String(r.id))).to.include(pm.collectionVariables.get('cancelId')));"
                ]
              }
            }
