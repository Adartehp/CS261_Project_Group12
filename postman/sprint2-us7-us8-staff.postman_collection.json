            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"A-101\",\n  \"area\": \"bathroom\",\n  \"repairItem\": \"ก๊อกน้ำรั่ว (Task41)\",\n  \"description\": \"ทดสอบยกเลิก\"\n}"
            }
