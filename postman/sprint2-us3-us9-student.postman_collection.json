              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('PENDING', () => pm.expect(b.status).to.eql('PENDING'));",
                  "pm.test('no acceptedAt', () => pm.expect(b.acceptedAt).to.be.null);"
                ]
