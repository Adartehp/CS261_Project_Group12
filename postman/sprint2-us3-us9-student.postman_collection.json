{
  "info": {
    "name": "Sprint 2 - US3 US9 Student status and history",
    "description": "Task34: ทดสอบสถานะ (US3) และประวัติ (US9) ของนักศึกษา\n\n1. รัน `docker compose up -d --build` แล้วเรียกผ่าน Nginx ที่ http://localhost:18080\n2. กรอก `studentEmail` และ `studentId` ด้วยบัญชี TU ที่ใช้ได้จริง (ห้าม commit ค่าจริง)\n3. ในฐานข้อมูลต้องมีคำร้องของนักศึกษาคนอื่นอย่างน้อย 1 รายการ ข้อ 1.2 จะเก็บ id ไว้ใน `otherId`\nRun ตามลำดับ Postman เก็บ session cookie ให้เอง",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('today', new Date().toLocaleDateString('en-CA'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "staffUsername",
      "value": "staff01"
    },
    {
      "key": "staffPassword",
      "value": "staff1234"
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "myId",
      "value": ""
    },
    {
      "key": "otherId",
      "value": ""
    },
    {
      "key": "today",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Setup - find another student's request",
      "item": [
        {
          "name": "1.1 Staff login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/staff/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "staff",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staffUsername}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Find a request of another student",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/repair-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "repair-requests"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const other = pm.response.json().find(r => r.studentId !== pm.collectionVariables.get('studentId'));",
                  "pm.test('another student has a request', () => pm.expect(other).to.be.ok);",
                  "pm.collectionVariables.set('otherId', other.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
