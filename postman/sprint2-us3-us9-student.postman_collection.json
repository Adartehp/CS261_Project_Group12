                "repair-requests",
                "mine"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only my requests', () => pm.response.json().forEach(r => pm.expect(r.studentId).to.eql(pm.collectionVariables.get('studentId'))));",
                  "pm.test('contains new request', () => pm.expect(pm.response.json().map(r => String(r.id))).to.include(String(pm.collectionVariables.get('myId'))));",
                  "pm.test('newest first', () => { const b = pm.response.json(); for (let i = 1; i < b.length; i++) pm.expect(b[i-1].createdAt >= b[i].createdAt).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Detail of my new request: PENDING, not accepted yet",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/repair-requests/{{myId}}",
              "host": [
